      "Bash(1 wc:*)",
      "Bash(head -30 grep -i \"api\\\\|search\\\\|endpoint\\\\|fetch\\\\|xhr\\\\|ajax\" /tmp/efast_page.html)",
      "Bash(grep -oE \"services[/a-zA-Z0-9_?=&%-]{2,100}\" /tmp/efast_main.js)",
